<UserControl x:Class="AIHub.Controls.ImageAnalysisBundleConfirmationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="ConfirmationCard"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="28"
                    MaxWidth="900"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{DynamicResource UiFont30}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DescriptionText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource UiFont14}"
                               LineHeight="{DynamicResource UiLineHeight22}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <Border x:Name="HeavyStartHintBorder"
                            Background="#1FFF9D00"
                            BorderBrush="#FFFF9D00"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14,11"
                            Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="HeavyStartHintText"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource UiFont13}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{DynamicResource StepBadgeBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14,11"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock x:Name="StateTitleText"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiFont17}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="StateDescriptionText"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont13}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                            <TextBlock x:Name="ErrorDetailsText"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont12}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="ComponentItemsControl"
                                  Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="14,11"
                                        Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DetailText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="{DynamicResource UiFont12}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,16,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StatusText}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="190" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="ProgressPanel"
                                Visibility="Collapsed"
                                Margin="0,8,0,0">
                        <TextBlock x:Name="ProgressStageText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource UiFont12}"
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="OperationProgressBar"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Margin="0,7,0,0" />
                        <TextBlock x:Name="ProgressValueText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource UiFont12}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0" />
                        <TextBlock x:Name="ProgressHintText"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="{DynamicResource UiFont12}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock x:Name="ModelsPathText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource UiFont12}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />

                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="PrimaryActionButton"
                                MinWidth="190"
                                Height="42"
                                Padding="18,0"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="PrimaryActionButton_Click" />
                        <Button x:Name="ViewHistoryButton"
                                MinWidth="190"
                                Height="42"
                                Padding="18,0"
                                Margin="10,0,0,0"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="ViewHistoryButton_Click" />
                        <Button x:Name="RemoveVisionButton"
                                MinWidth="210"
                                Height="42"
                                Padding="18,0"
                                Margin="10,0,0,0"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="RemoveVisionButton_Click" />
                        <Button x:Name="CancelOperationButton"
                                MinWidth="130"
                                Height="42"
                                Padding="18,0"
                                Margin="10,0,0,0"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="CancelOperationButton_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Width="{Binding ActualWidth, ElementName=ConfirmationCard}"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <Button x:Name="BackToBundlesButton"
                    Height="40"
                    MinWidth="164"
                    Padding="18,0"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="BackToBundlesButton_Click" />
            <Button x:Name="BackToWorkStartButton"
                    Height="40"
                    MinWidth="164"
                    Padding="18,0"
                    Margin="10,0,0,0"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="BackToWorkStartButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
