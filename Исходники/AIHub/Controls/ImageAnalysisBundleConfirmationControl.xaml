<UserControl x:Class="AIHub.Controls.ImageAnalysisBundleConfirmationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="30"
                MaxWidth="760"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <Border Width="54"
                        Height="54"
                        Background="{DynamicResource StepBadgeBrush}"
                        CornerRadius="27"
                        HorizontalAlignment="Left">
                    <TextBlock Text="✓"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="27"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0" />
                <TextBlock x:Name="DescriptionText"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="15"
                           LineHeight="24"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <Border Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="16,12"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock x:Name="BundleTitleText"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="BundleSummaryText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="NextStepText"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0">
            <Button x:Name="BackToBundlesButton"
                    Height="40"
                    MinWidth="164"
                    Padding="18,0"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="BackToBundlesButton_Click" />
            <Button x:Name="BackToWorkStartButton"
                    Height="40"
                    MinWidth="164"
                    Padding="18,0"
                    Margin="10,0,0,0"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="BackToWorkStartButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
