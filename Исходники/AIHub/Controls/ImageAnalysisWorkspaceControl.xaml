<UserControl x:Class="AIHub.Controls.ImageAnalysisWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="30"
                MaxWidth="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="14"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
                <Button x:Name="SelectImageButton"
                        Width="210"
                        Height="44"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Margin="0,20,0,0"
                        Click="SelectImageButton_Click" />
                <Border x:Name="SelectedFilePanel"
                        Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="14"
                        Margin="0,16,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SelectedFileTitleText"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedFileDetailsText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="BoundaryText"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Border>
        <Button x:Name="BackButton"
                Grid.Row="1"
                Height="40"
                MinWidth="180"
                HorizontalAlignment="Left"
                Style="{DynamicResource SecondaryButtonStyle}"
                Margin="0,16,0,0"
                Click="BackButton_Click" />
    </Grid>
</UserControl>
