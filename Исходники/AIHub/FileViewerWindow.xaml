<Window x:Class="AIHub.FileViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOPATA"
        Width="1180"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="FileNameText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FileDetailsText"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="OpenExternalButton"
                            Padding="14,8"
                            Click="OpenExternalButton_Click" />
                    <Button x:Name="ShowInExplorerButton"
                            Padding="14,8"
                            Margin="8,0,0,0"
                            Click="ShowInExplorerButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20">
            <TextBox x:Name="TextViewer"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="14"
                     Visibility="Collapsed" />
            <ScrollViewer x:Name="ImageViewerScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <Image x:Name="ImageViewer"
                       Stretch="None" />
            </ScrollViewer>
            <DataGrid x:Name="TableViewer"
                      IsReadOnly="True"
                      AutoGenerateColumns="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      Visibility="Collapsed" />
            <Grid x:Name="MediaViewerPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <MediaElement x:Name="MediaViewer"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              Stretch="Uniform" />
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0">
                    <Button x:Name="MediaPlayButton"
                            Padding="14,7"
                            Click="MediaPlayButton_Click" />
                    <Button x:Name="MediaPauseButton"
                            Padding="14,7"
                            Margin="8,0,0,0"
                            Click="MediaPauseButton_Click" />
                    <Button x:Name="MediaStopButton"
                            Padding="14,7"
                            Margin="8,0,0,0"
                            Click="MediaStopButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border x:Name="StatusBorder"
                Grid.Row="2"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
