<Window x:Class="AIHub.SessionTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session tree"
        Width="1180"
        Height="780"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="Assets/AppIcon.ico"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111827" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="PanelBrush" Color="#172033" />
        <SolidColorBrush x:Key="LineBrush" Color="#2D374B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB4C4" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED" />

        <Style x:Key="TreeToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeadingText"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="HintText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,5,20,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ZoomText"
                               Text="100%"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                    <Button x:Name="ZoomOutButton"
                            Content="−"
                            Style="{StaticResource TreeToolbarButtonStyle}"
                            Click="ZoomOutButton_Click" />
                    <Button x:Name="ZoomInButton"
                            Content="+"
                            Style="{StaticResource TreeToolbarButtonStyle}"
                            Click="ZoomInButton_Click" />
                    <Button x:Name="FitButton"
                            Content="⌖"
                            Style="{StaticResource TreeToolbarButtonStyle}"
                            Click="FitButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="18"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ScrollViewer x:Name="TreeScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="TreeScrollViewer_PreviewMouseWheel"
                              PreviewMouseLeftButtonDown="TreeScrollViewer_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="TreeScrollViewer_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="TreeScrollViewer_PreviewMouseLeftButtonUp">
                    <Canvas x:Name="TreeCanvas"
                            Background="Transparent" />
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1"
                    Margin="0,18,18,18"
                    Padding="16"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetailsHeadingText"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailsTypeText"
                               Grid.Row="1"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,7,0,0" />
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,12,0,0">
                        <TextBlock x:Name="DetailsContentText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Button x:Name="CollapseBranchButton"
                            Grid.Row="3"
                            Height="36"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            Click="CollapseBranchButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
