<Window x:Class="AIHub.ExecutorResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Executor result"
        Width="920"
        Height="760"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="Assets/AppIcon.ico"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111827" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="PanelBrush" Color="#172033" />
        <SolidColorBrush x:Key="LineBrush" Color="#2D374B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB4C4" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="WindowHeadingText"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="WindowHintText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,5,16,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            MinWidth="280">
                    <TextBlock x:Name="VersionLabelText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,0,0,5" />
                    <ComboBox x:Name="SnapshotSelector"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="SnapshotSelector_SelectionChanged" />
                    <TextBlock x:Name="ArtifactDetailsText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                Margin="24"
                CornerRadius="8"
                ClipToBounds="True">
            <FlowDocumentScrollViewer x:Name="DocumentViewer"
                                      IsSelectionEnabled="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource PanelBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderThickness="0"
                                      Zoom="100" />
        </Border>
    </Grid>
</Window>
