<Window x:Class="AIHub.DebugChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI HUB — Debug Model Tester"
        Width="1040"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111827" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="PanelBrush" Color="#172033" />
        <SolidColorBrush x:Key="LineBrush" Color="#2D374B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB4C4" />
        <SolidColorBrush x:Key="NativeComboTextBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="InputSelectedBrush" Color="#244A85" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6BED" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="#D0D7E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource NativeComboTextBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource NativeComboTextBrush}" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource NativeComboTextBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Padding" Value="8,4" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#DCEBFF" />
                    <Setter Property="Foreground" Value="{DynamicResource NativeComboTextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFF" />
                    <Setter Property="Foreground" Value="{DynamicResource NativeComboTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="WrappingListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,2" />
        </Style>

        <DataTemplate x:Key="WrappingTextItemTemplate">
            <TextBlock Text="{Binding}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
        </DataTemplate>

        <Style x:Key="NoHorizontalScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="PrimaryDebugButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="Debug Model Tester"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock x:Name="DescriptionText"
                               Text="Отладочное окно проверки локальных GGUF-моделей"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button x:Name="RefreshModelsButton"
                        Grid.Column="1"
                        Content="Обновить"
                        Click="RefreshModelsButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ModelLabelText"
                               Text="Модель"
                               FontWeight="SemiBold" />
                    <ComboBox x:Name="ModelsComboBox"
                              Grid.Row="2"
                              MinHeight="34"
                              SelectionChanged="ModelsComboBox_SelectionChanged"
                              TextElement.Foreground="{DynamicResource NativeComboTextBrush}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource NativeComboTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock x:Name="StatusLabelText"
                               Grid.Column="2"
                               Text="Состояние"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText"
                               Grid.Row="2"
                               Grid.Column="2"
                               Text="Ожидание"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ChatLabelText"
                               Text="Чат"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10" />

                    <ListBox x:Name="ChatListBox"
                             Grid.Row="1"
                             ItemContainerStyle="{StaticResource WrappingListBoxItemStyle}"
                             ItemTemplate="{StaticResource WrappingTextItemTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="PromptTextBox"
                                 MinHeight="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 KeyDown="PromptTextBox_KeyDown" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SendButton"
                                    Content="Отправить"
                                    Style="{StaticResource PrimaryDebugButtonStyle}"
                                    Click="SendButton_Click" />
                            <Button x:Name="StopButton"
                                    Content="Стоп"
                                    Margin="8,0,0,0"
                                    IsEnabled="False"
                                    Click="StopButton_Click" />
                            <Button x:Name="ClearChatButton"
                                    Content="Очистить чат"
                                    Margin="8,0,0,0"
                                    Click="ClearChatButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="LogLabelText"
                               Text="Логи"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10" />

                    <ListBox x:Name="LogListBox"
                             Grid.Row="1"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             ItemContainerStyle="{StaticResource WrappingListBoxItemStyle}"
                             ItemTemplate="{StaticResource WrappingTextItemTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <Button x:Name="ClearLogButton"
                            Grid.Row="2"
                            Content="Очистить лог"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Click="ClearLogButton_Click" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <TextBlock x:Name="FooterText"
                       Text="Debug: модель не получает доступ к файлам, интернету, shell и системным настройкам."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
