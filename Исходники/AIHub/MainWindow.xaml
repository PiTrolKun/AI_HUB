<Window x:Class="AIHub.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI HUB"
        Width="980"
        Height="640"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        Icon="Assets/AppIcon.ico"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D6470" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#DADDE3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="StepBadgeBrush" Color="#EAF1FF" />
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#F8F8F8" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="156" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="#C9CDD4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="7"
                            Background="#1D4ED8">
                        <TextBlock Text="AI"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock x:Name="HeaderProductNameText"
                                   Text="AI_HUB"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="HeaderSubtitleText"
                                   Text="Локальная AI-мастерская для Windows"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="SettingsButton"
                            Content="⚙"
                            Style="{StaticResource ThemeButtonStyle}"
                            ToolTip="Открыть настройки"
                            Margin="0,0,10,0"
                            Click="SettingsButton_Click" />
                    <Button x:Name="ThemeToggleButton"
                            Content="☾"
                            Style="{StaticResource ThemeButtonStyle}"
                            ToolTip="Переключить на тёмную тему"
                            Click="ThemeToggleButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WelcomePage" Grid.Row="1" Margin="56,44,56,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock x:Name="HomeWelcomeTitleText"
                           Text="Добро пожаловать"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="34"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="HomeHeadlineText"
                           Text="Подготовим место для локального ИИ"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,14,0,0" />
                <TextBlock x:Name="HomeDescriptionText"
                           Text="AI_HUB будет хранить модели, результаты и служебные файлы на выбранных дисках. Сейчас ничего не скачивается и не меняется без вашего подтверждения."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="15"
                           LineHeight="24"
                           TextWrapping="Wrap"
                           Margin="0,12,18,0" />

                <StackPanel Orientation="Horizontal" Margin="0,34,0,0">
                    <Button x:Name="PrimaryActionButton"
                            Content="Начать настройку"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="PrimaryActionButton_Click" />
                    <Button x:Name="ReconfigureButton"
                            Content="Перенастроить"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="124"
                            Margin="12,0,0,0"
                            Click="ReconfigureButton_Click" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="WhatWillBeConfiguredTitleText"
                               Text="Что будет настроено"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource StepBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="1"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ModelsStorageTitleText"
                                       Text="Хранилище моделей"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ModelsStorageStepText"
                                       Text="Выберем диск и лимит для будущих скачиваний."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource StepBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="2"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ResultsStorageTitleText"
                                       Text="Папка результатов"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ResultsStorageStepText"
                                       Text="Отделим созданные файлы от моделей и кэша."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource StepBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="3"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ComputerPassportTitleText"
                                       Text="Паспорт компьютера"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ComputerPassportStepText"
                                       Text="Посмотрим RAM, GPU, VRAM и свободное место."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SetupPage"
              Grid.Row="1"
              Margin="56,44,56,36"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="SetupTitleText"
                           Text="Настройка AI HUB"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="32"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SetupDescriptionText"
                           Text="Это подготовительная страница будущего мастера настройки. Сейчас программа только создаёт паспорт компьютера и не меняет системные настройки."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="15"
                           LineHeight="24"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SetupPriorityHintText"
                               Text="Первый адрес используется по умолчанию. Остальные можно будет выбрать вручную там, где это потребуется."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />

                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="SetupModelsTitleText"
                                       Text="Хранилище моделей"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SetupModelsHelpText"
                                       Text="Добавьте путь вручную или выберите папку Windows. Поле рядом — лимит этого адреса в ГБ."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <Grid Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ModelsAddressLabelText"
                                           Text="Адрес хранения"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBlock x:Name="ModelsLimitLabelText"
                                           Grid.Column="1"
                                           Text="Лимит адреса, ГБ"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="8,0,0,0" />
                                <TextBox x:Name="ModelsPathInput"
                                         Grid.Row="2"
                                         Height="34"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Можно вставить или написать путь вручную" />
                                <TextBox x:Name="ModelsLocationLimitInput"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Лимит этого адреса в ГБ" />
                                <Button x:Name="BrowseModelsLocationButton"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Content="Выбрать"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="92"
                                        Margin="8,0,0,0"
                                        Click="BrowseModelsLocationButton_Click" />
                                <Button x:Name="AddModelsLocationButton"
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Content="Добавить"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="94"
                                        Margin="8,0,0,0"
                                        Click="AddModelsLocationButton_Click" />
                            </Grid>
                            <ListBox x:Name="ModelsLocationList"
                                     Height="82"
                                     Margin="0,10,0,0"
                                     SelectionChanged="ModelsLocationList_SelectionChanged" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="MoveModelsLocationUpButton"
                                        Content="Вверх"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="MoveModelsLocationUpButton_Click" />
                                <Button x:Name="MoveModelsLocationDownButton"
                                        Content="Вниз"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="MoveModelsLocationDownButton_Click" />
                                <Button x:Name="RemoveModelsLocationButton"
                                        Content="Удалить"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="RemoveModelsLocationButton_Click" />
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ModelsTotalLimitLabelText"
                                           Text="Общий лимит, ГБ"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="ModelsTotalLimitInput"
                                         Grid.Column="1"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center" />
                                <CheckBox x:Name="ModelsAllowOverflowCheckBox"
                                          Grid.Column="2"
                                          Content="Временное превышение"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="16,0,0,0" />
                                <TextBlock x:Name="ModelsPlusGbText"
                                           Grid.Column="3"
                                           Text="+ ГБ"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                                <TextBox x:Name="ModelsTemporaryOverflowInput"
                                         Grid.Column="4"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="SetupResultsTitleText"
                                       Text="Папка результатов"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SetupResultsHelpText"
                                       Text="Добавьте путь вручную или выберите папку Windows. Поле рядом — лимит этого адреса в ГБ."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <Grid Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResultsAddressLabelText"
                                           Text="Адрес хранения"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBlock x:Name="ResultsLimitLabelText"
                                           Grid.Column="1"
                                           Text="Лимит адреса, ГБ"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="8,0,0,0" />
                                <TextBox x:Name="ResultsPathInput"
                                         Grid.Row="2"
                                         Height="34"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Можно вставить или написать путь вручную" />
                                <TextBox x:Name="ResultsLocationLimitInput"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Лимит этого адреса в ГБ" />
                                <Button x:Name="BrowseResultsLocationButton"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Content="Выбрать"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="92"
                                        Margin="8,0,0,0"
                                        Click="BrowseResultsLocationButton_Click" />
                                <Button x:Name="AddResultsLocationButton"
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Content="Добавить"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="94"
                                        Margin="8,0,0,0"
                                        Click="AddResultsLocationButton_Click" />
                            </Grid>
                            <ListBox x:Name="ResultsLocationList"
                                     Height="82"
                                     Margin="0,10,0,0"
                                     SelectionChanged="ResultsLocationList_SelectionChanged" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="MoveResultsLocationUpButton"
                                        Content="Вверх"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="MoveResultsLocationUpButton_Click" />
                                <Button x:Name="MoveResultsLocationDownButton"
                                        Content="Вниз"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="MoveResultsLocationDownButton_Click" />
                                <Button x:Name="RemoveResultsLocationButton"
                                        Content="Удалить"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="RemoveResultsLocationButton_Click" />
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResultsTotalLimitLabelText"
                                           Text="Общий лимит, ГБ"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="ResultsTotalLimitInput"
                                         Grid.Column="1"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center" />
                                <CheckBox x:Name="ResultsAllowOverflowCheckBox"
                                          Grid.Column="2"
                                          Content="Временное превышение"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="16,0,0,0" />
                                <TextBlock x:Name="ResultsPlusGbText"
                                           Grid.Column="3"
                                           Text="+ ГБ"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                                <TextBox x:Name="ResultsTemporaryOverflowInput"
                                         Grid.Column="4"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="SetupPassportTitleText"
                                       Text="Паспорт компьютера"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="PassportSummaryText"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="14"
                                       LineHeight="24"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                            <TextBlock x:Name="PassportPathText"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BackToStartButton"
                        Content="Назад"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackToStartButton_Click" />
                <Button x:Name="SaveStorageSettingsButton"
                        Content="Сохранить"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,0,0"
                        Click="SaveStorageSettingsButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="SettingsPage"
              Grid.Row="1"
              Margin="56,44,56,36"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="SettingsTitleText"
                           Text="Настройки"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="32"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SettingsDescriptionText"
                           Text="Здесь будут общие настройки AI HUB. Сейчас доступен выбор языка интерфейса."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="15"
                           LineHeight="24"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    MaxWidth="560"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock x:Name="SettingsLanguageTitleText"
                               Text="Язык интерфейса"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SettingsLanguageHelpText"
                               Text="Можно выбрать встроенный язык или добавить свой JSON-файл перевода в папку локализации пользователя."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock x:Name="SettingsLanguageLabelText"
                               Text="Текущий язык"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,18,0,6" />
                    <ComboBox x:Name="LanguageComboBox"
                              Width="220"
                              HorizontalAlignment="Left"
                              SelectionChanged="LanguageComboBox_SelectionChanged" />
                    <TextBlock x:Name="SettingsLocalizationFolderText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BackFromSettingsButton"
                        Content="Назад"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackFromSettingsButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <TextBlock x:Name="StatusText"
                           Text="Статус: прототип стартового окна. Скачивание моделей и изменение настроек пока не выполняются."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
